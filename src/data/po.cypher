LOAD CSV WITH HEADERS FROM '{file_path}' AS row
CREATE (p:Provider {{
    fname: row.fname,
    lname: row.lname,
    fullname: row.fullname,
    category: row.category,
    payments_to: row.payments_to, 
    sap_no: toInteger(row.sap_no), 
    sap_name: row.sap_name, 
    state1: row.state1, 
    state2: row.state2, 
    country: row.country,
    npi: toInteger(row.npi),
    license: toInteger(row.license),
    lic_state: row.lic_state,
    title: row.title,
    specialty: row.specialty,
    fc_area: row.fc_area,
    taxonomy: row.taxonomy,
    tax_code: row.tax_code,
    currency: row.currency,
    email: row.email,
    addr1: row.addr1,
    addr2: row.addr2,
    org: row.org,
    org_type: row.org_type,
    qb_id: toInteger(row.qb_id),
    id: row.id,
    text: row.text
}});
