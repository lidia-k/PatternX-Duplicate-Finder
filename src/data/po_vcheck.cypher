LOAD CSV WITH HEADERS FROM '{file_path}' AS row
CREATE (p:Provider {{
    fullname: row.fullname,
    npi: toInteger(row.npi),
    nppes_data: row.nppes_data,
    credential: row.credential,
    fname: row.fname,
    middle_name: row.mname,
    lname: row.lname,
    gender: row.gender,
    last_updated: row.last_updated,
    status: row.status,
    address_1: row.addr1,
    address_2: row.addr2,
    city: row.city,
    state: row.state,
    zip: row.zip,
    country_code: row.country,
    code: row.code,
    desc: row.desc,
    license: row.license,
    state: row.state,
    primary: toBoolean(row.primary),
    uid: row.uid,
    text: row.text
}})
