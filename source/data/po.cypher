LOAD CSV WITH HEADERS FROM '{file_path}' AS row
CREATE (p:Provider {{
    status: row.status,
    ctype: row.ctype,
    prefix: row.prefix,
    fname: row.fname,
    lname: row.lname,
    fullname: row.fullname,
    category: row.category,
    paymentsTo: row.payments_to,
    sapNo: toInteger(row.sap_no),
    sapName: row.sap_name,
    state1: row.state1,
    state2: row.state2,
    country: row.country,
    npi: toInteger(row.npi),
    license: toInteger(row.license),
    licState: row.lic_state,
    title: row.title,
    specialty: row.specialty,
    focusArea: row.fc_area,
    taxonomy: row.taxonomy,
    taxCode: row.tax_code,
    currency: row.currency,
    email: row.email,
    addr1: row.addr1,
    addr2: row.addr2,
    org: row.org,
    orgType: row.org_type,
    qbId: toInteger(row.qb_id),
    id: row.id
}});
