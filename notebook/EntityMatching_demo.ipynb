        "    train_idx = range(valid_idx[-1], df.shape[0])\n",
        "    \n",
        "\n",
        "    splits = (list(train_idx),list(valid_idx))\n",
        "    procs = [Categorify, FillMissing]\n",
        "    to = TabularPandas(df, procs, cat, cont, y_names=dep_var, splits=splits)\n",
        "\n",
        "    return to, cont, cat\n",
