        "## Using traditional ML approaches"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 34,
      "metadata": {},
      "outputs": [],
      "source": [
        "def build_tabular_dataloader(df,  dep_var = 'n_trips'):\n",
        "    cont,cat = cont_cat_split(df, 20, dep_var=dep_var)\n",
        "\n",
        "    np.random.seed(0)\n",
        "    valid_idx = np.random.choice(df.shape[0], len(df)//10*3, replace=False)\n",
        "    train_idx = range(valid_idx[-1], df.shape[0])\n",
        "    \n",
        "\n",
        "    splits = (list(train_idx),list(valid_idx))\n",
        "    procs = [Categorify, FillMissing]\n",
        "    to = TabularPandas(df, procs, cat, cont, y_names=dep_var, splits=splits)\n",
        "\n",
        "    return to, cont, cat\n",
        "\n",
        "def rf_feat_importance(m, features):\n",
        "    return pd.DataFrame({'cols':features, 'imp':m.feature_importances_}).sort_values('imp', ascending=False)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 106,
      "metadata": {},
      "outputs": [],
      "source": [
        "selected_features =[ f for f in  df.columns.tolist() if f!=\"id\"]\n",
        "regression_dataloader, cont, cat = build_tabular_dataloader(df[selected_features], dep_var='label')\n",
        "xs,y = regression_dataloader.train.xs, regression_dataloader.train.y\n",
        "valid_xs,valid_y = regression_dataloader.valid.xs, regression_dataloader.valid.y"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 69,
      "metadata": {},
      "outputs": [],
      "source": [
        "models = {\n",
        "    'LogisticRegression': LogisticRegression(), \n",
        "    'DecisionTreeClassifier': DecisionTreeClassifier(),\n",
        "    'KNeighborsClassifier': KNeighborsClassifier(),\n",
        "    'GradientBoostingClassifier': GradientBoostingClassifier(),\n",
        "    'XGBClassifier': XGBClassifier()\n",
        "}"
      ]
    },
